+/* ---- polaris P1b-7: GMU preflight, reset still held (dipper step 14) -------------------
+ *
+ * Before the M3 is let out of reset it needs its boot configuration: fifteen registers
+ * (boot config, HFI queue table address, AHB fence range, cache config, RPMh vote) and
+ * the HFI queue table itself, in the region step 12 mapped at 0x60009000.
+ *
+ * Nothing is started here: the M3 stays in reset, the configuration is read back, and
+ * then put back the way it was found.  Gated by boot-arg polarisgpu=14.
+ */
+
+struct polaris_hfi_table {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
+};
+
+struct polaris_hfi_queue {
+	uint32_t status, iova, type, size, msg_size, dropped;
+	uint32_t rx_watermark, tx_watermark, rx_request, tx_request, read_index, write_index;
+};
+
+static struct {
+	const char *name;
+	uint32_t word, value, old;
+} polaris_gmu_boot_regs[] = {
+	{ "GMU_GENERAL_7", 0x51cc, 0x1, 0 },
+	{ "GMU_CM3_FW_INIT_RESULT", 0x501c, 0x0, 0 },
+	{ "GMU_CM3_BOOT_CONFIG", 0x5001, 0x2, 0 },
+	{ "GMU_HFI_QTBL_ADDR", 0x5185, 0x60009000, 0 },
+	{ "GMU_HFI_QTBL_INFO", 0x5184, 0x1, 0 },
+	{ "GMU_AHB_FENCE_RANGE_0", 0x9311, 0x802800a0, 0 },
+	{ "GMU_CM3_CFG", 0x502d, 0x4052, 0 },
+	{ "GMU_HFI_SFR_ADDR", 0x5182, 0x6030100, 0 },
+	{ "GPU_GMU_CX_GMU_PWR_COL_CP_MSG", 0x5100, 0x60005003, 0 },
+	{ "GMU_SYS_BUS_CONFIG", 0x4c0f, 0x1, 0 },
+	{ "GMU_ICACHE_CONFIG", 0x4c00, 0x1, 0 },
+	{ "GMU_DCACHE_CONFIG", 0x4c01, 0x1, 0 },
+	{ "GMU_PWR_COL_INTER_FRAME_CTRL", 0x50c0, 0x9c40400, 0 },
+	{ "GMU_RPMH_CTRL", 0x50e8, 0xf11, 0 },
+	{ "GPU_GMU_CX_GMU_PWR_COL_CP_RESP", 0x5101, 0x0, 0 },
+};
+#define POLARIS_GMU_BOOT_REGS ((uint32_t)(sizeof(polaris_gmu_boot_regs) / sizeof(polaris_gmu_boot_regs[0])))
+static uint32_t polaris_gmu_boot_written;
+
+static bool
+polaris_gmu_boot_restore(void)
+{
+	uint32_t count = polaris_gmu_boot_written, different = 0, i;
+
+	if (count == 0) {
+		return true;
+	}
+	/* This is only a reset-state restore, not a shutdown procedure for a running GMU. */
+	if (polaris_rd(polaris_gmu_base + 4u * 0x5000) != 1) {
+		POLARIS_LOG("polaris-gpu: step 14 the GMU is no longer in reset; not restoring\n");
+		return false;
+	}
+	while (polaris_gmu_boot_written > 0) {
+		i = --polaris_gmu_boot_written;
+		polaris_wr(polaris_gmu_base + 4u * polaris_gmu_boot_regs[i].word, polaris_gmu_boot_regs[i].old);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (i = 0; i < count; i++) {
+		uint32_t back = polaris_rd(polaris_gmu_base + 4u * polaris_gmu_boot_regs[i].word);
+
+		if (back != polaris_gmu_boot_regs[i].old) {
+			POLARIS_LOG("polaris-gpu: step 14 boot restore mismatch %s wanted %#010x got %#010x\n",
+			    polaris_gmu_boot_regs[i].name, polaris_gmu_boot_regs[i].old, back);
+			different++;
+		}
+	}
+	POLARIS_LOG("polaris-gpu: step 14 boot configuration restoration %s (%u registers)\n",
+	    different ? "FAIL" : "PASS", count);
+	return different == 0;
+}
+
+/* step 14: the boot configuration, written while the M3 is held in reset */
+static bool
+polaris_step_gmu_prepare(void)
+{
+	struct polaris_hfi_table *t = (struct polaris_hfi_table *)polaris_gmu_regions[3].memory;
+	struct polaris_hfi_queue *q = (struct polaris_hfi_queue *)(polaris_gmu_regions[3].memory + sizeof(*t));
+	static const uint32_t ids[] = { 0, 4, 5 };  /* legacy response/debug IDs */
+	uint32_t i;
+	bool ok;
+
+	if (polaris_gmu_base == 0 || polaris_gmu_regions[3].memory == 0 ||
+	    polaris_gmu_regions[3].size != 0x4000 || polaris_gmu_regions[3].address != 0x60009000) {
+		POLARIS_LOG("polaris-gpu: step 14 the GMU or its HFI region is not set up (steps 6/12)\n");
+		return false;
+	}
+	if (polaris_rd(polaris_gmu_base + 4u * 0x5000) != 1 ||
+	    (polaris_rd(polaris_gpucc + 0x100c) & (1u << 31))) {
+		POLARIS_LOG("polaris-gpu: step 14 preflight prerequisites not met (reset %#x GX %#x)\n",
+		    polaris_rd(polaris_gmu_base + 4u * 0x5000), polaris_rd(polaris_gpucc + 0x100c));
+		return false;
+	}
+
+	/* the HFI table a6xx_hfi_init() writes: three queues of 4 KB each, type 10 (legacy) */
+	__builtin_memset(polaris_gmu_regions[3].memory, 0, polaris_gmu_regions[3].size);
+	t->version = 0;
+	t->size = sizeof(*t) + 3 * sizeof(*q);
+	t->qhdr0_offset = sizeof(*t) / 4;
+	t->qhdr_size = sizeof(*q) / 4;
+	t->num_queues = t->active_queues = 3;
+	for (i = 0; i < 3; i++) {
+		q[i].status = 1;
+		q[i].iova = (uint32_t)polaris_gmu_regions[3].address + 0x1000 * (i + 1);
+		q[i].type = (10u << 8) | ids[i];
+		q[i].size = 0x1000 / 4;
+		q[i].rx_watermark = q[i].tx_watermark = q[i].rx_request = 1;
+		POLARIS_LOG("polaris-gpu: step 14 HFI queue %u id %u iova %#x type %#x capacity %u words\n",
+		    i, ids[i], q[i].iova, q[i].type, q[i].size);
+	}
+	polaris_to_memory((vm_offset_t)polaris_gmu_regions[3].memory, polaris_gmu_regions[3].size);
+	POLARIS_LOG("polaris-gpu: step 14 HFI table %u bytes, header offset/size %u/%u words, %u queues (not started)\n",
+	    t->size, t->qhdr0_offset, t->qhdr_size, t->num_queues);
+	polaris_log_barrier();
+
+	for (i = 0; i < POLARIS_GMU_BOOT_REGS; i++) {
+		vm_offset_t address = polaris_gmu_base + 4u * polaris_gmu_boot_regs[i].word;
+		uint32_t back, value = polaris_gmu_boot_regs[i].value;
+
+		polaris_gmu_boot_regs[i].old = polaris_rd(address);
+		if (polaris_gmu_boot_regs[i].word == 0x50e8) {
+			value |= polaris_gmu_boot_regs[i].old;  /* RPMH_CTRL ORs the requested bits in */
+		}
+		polaris_wr(address, value);
+		polaris_gmu_boot_written = i + 1;
+		back = polaris_rd(address);
+		POLARIS_LOG("polaris-gpu: step 14 %-32s was %#010x wrote %#010x read %#010x%s\n",
+		    polaris_gmu_boot_regs[i].name, polaris_gmu_boot_regs[i].old, value, back,
+		    (back == value) ? "" : "  DIFFERENT");
+	}
+	POLARIS_LOG("polaris-gpu: step 14 configured %u registers; SYSRESET %#x FW_INIT_RESULT %#x GX %#x (not released)\n",
+	    POLARIS_GMU_BOOT_REGS, polaris_rd(polaris_gmu_base + 4u * 0x5000),
+	    polaris_rd(polaris_gmu_base + 4u * 0x501c), polaris_rd(polaris_gpucc + 0x100c));
+	polaris_log_barrier();
+
+	ok = polaris_rd(polaris_gmu_base + 4u * 0x5000) == 1 && polaris_rd(polaris_gmu_base + 4u * 0x501c) == 0;
+	{
+		bool restored = polaris_gmu_boot_restore();
+
+		if (!restored) {
+			POLARIS_LOG("polaris-gpu: step 14 WARNING: the boot registers were not put back\n");
+			return false;
+		}
+	}
+	POLARIS_LOG("polaris-gpu: step 14 the GMU boot configuration %s\n", ok ? "PASS" : "FAIL");
+	polaris_log_barrier();
+	return ok;
+}
 void
 PE_init_iokit(void)
 {
