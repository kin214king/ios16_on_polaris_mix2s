+/* ---- polaris P1b-4: RSC/PDC (dipper step 11) --------------------------------------------
+ *
+ * The GPU's RPMh sequencer: the RSC (inside the GMU's register window at +0x23000)
+ * and the PDC (two separate register blocks).  Linux's a6xx_gmu_rpmh_init() writes
+ * the same table for a630; the values come from there.
+ *
+ * This is a diagnostic, so the table is programmed, read back against fixed-bit
+ * masks, and then put back the way it was found.  Gated by polarisgpu=11.
+ */
+
+#define POLARIS_PDC_PHYS              0x0b280000UL
+#define POLARIS_PDC_SEQ_PHYS          0x0b480000UL
+#define POLARIS_PDC_SIZE              0x00010000UL
+#define POLARIS_RSCC_OFFSET           0x23000u
+#define POLARIS_GPUCC_GX_GDSCR         0x100c
+
+enum { POLARIS_RS_RSCC, POLARIS_RS_PDC, POLARIS_RS_SEQ };
+
+static struct polaris_rs_write {
+	uint8_t		region;
+	uint16_t	word;
+	const char	*name;
+	uint32_t	value;
+	uint32_t	old;
+} polaris_rs_writes[] = {
+	{ POLARIS_RS_RSCC, 0x0004, "RSC_STATUS0_DRV0", 1u << 24, 0 },
+	{ POLARIS_RS_RSCC, 0x000b, "RSCC_PDC_SLAVE_ID_DRV0", 1, 0 },
+	{ POLARIS_RS_RSCC, 0x000e, "RSCC_HIDDEN_TCS_CMD0_DATA", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x000d, "RSCC_HIDDEN_TCS_CMD0_ADDR", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x0010, "RSCC_HIDDEN_TCS_CMD0_DATA+2", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x000f, "RSCC_HIDDEN_TCS_CMD0_ADDR+2", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x0012, "RSCC_HIDDEN_TCS_CMD0_DATA+4", 0x80000000u, 0 },
+	{ POLARIS_RS_RSCC, 0x0011, "RSCC_HIDDEN_TCS_CMD0_ADDR+4", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x0100, "RSCC_OVERRIDE_START_ADDR", 0, 0 },
+	{ POLARIS_RS_RSCC, 0x0008, "RSCC_PDC_SEQ_START_ADDR", 0x4520, 0 },
+	{ POLARIS_RS_RSCC, 0x0009, "RSCC_PDC_MATCH_VALUE_LO", 0x4510, 0 },
+	{ POLARIS_RS_RSCC, 0x000a, "RSCC_PDC_MATCH_VALUE_HI", 0x4514, 0 },
+	{ POLARIS_RS_RSCC, 0x0180, "RSCC_SEQ_MEM_0_DRV0", 0xa7a506a0u, 0 },
+	{ POLARIS_RS_RSCC, 0x0181, "RSCC_SEQ_MEM_0_DRV0+1", 0xa1e6a6e7u, 0 },
+	{ POLARIS_RS_RSCC, 0x0182, "RSCC_SEQ_MEM_0_DRV0+2", 0xa2e081e1u, 0 },
+	{ POLARIS_RS_RSCC, 0x0183, "RSCC_SEQ_MEM_0_DRV0+3", 0xe9a982e2u, 0 },
+	{ POLARIS_RS_RSCC, 0x0184, "RSCC_SEQ_MEM_0_DRV0+4", 0x0020e8a8u, 0 },
+	{ POLARIS_RS_SEQ, 0x0000, "PDC_GPU_SEQ_MEM_0", 0xfebea1e1u, 0 },
+	{ POLARIS_RS_SEQ, 0x0001, "PDC_GPU_SEQ_MEM_0+1", 0xa5a4a3a2u, 0 },
+	{ POLARIS_RS_SEQ, 0x0002, "PDC_GPU_SEQ_MEM_0+2", 0x8382a6e0u, 0 },
+	{ POLARIS_RS_SEQ, 0x0003, "PDC_GPU_SEQ_MEM_0+3", 0xbce3e284u, 0 },
+	{ POLARIS_RS_SEQ, 0x0004, "PDC_GPU_SEQ_MEM_0+4", 0x002081fcu, 0 },
+	{ POLARIS_RS_PDC, 0x1573, "PDC_GPU_TCS1_CMD_ENABLE_BANK", 7, 0 },
+	{ POLARIS_RS_PDC, 0x1574, "PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK", 0, 0 },
+	{ POLARIS_RS_PDC, 0x1572, "PDC_GPU_TCS1_CONTROL", 0, 0 },
+	{ POLARIS_RS_PDC, 0x1575, "PDC_GPU_TCS1_CMD0_MSGID", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x1576, "PDC_GPU_TCS1_CMD0_ADDR", 0x30010, 0 },
+	{ POLARIS_RS_PDC, 0x1577, "PDC_GPU_TCS1_CMD0_DATA", 1, 0 },
+	{ POLARIS_RS_PDC, 0x1579, "PDC_GPU_TCS1_CMD0_MSGID+4", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x157a, "PDC_GPU_TCS1_CMD0_ADDR+4", 0x30000, 0 },
+	{ POLARIS_RS_PDC, 0x157b, "PDC_GPU_TCS1_CMD0_DATA+4", 0, 0 },
+	{ POLARIS_RS_PDC, 0x157d, "PDC_GPU_TCS1_CMD0_MSGID+8", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x157e, "PDC_GPU_TCS1_CMD0_ADDR+8", 0x30080, 0 },
+	{ POLARIS_RS_PDC, 0x157f, "PDC_GPU_TCS1_CMD0_DATA+8", 0, 0 },
+	{ POLARIS_RS_PDC, 0x15d7, "PDC_GPU_TCS3_CMD_ENABLE_BANK", 7, 0 },
+	{ POLARIS_RS_PDC, 0x15d8, "PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK", 0, 0 },
+	{ POLARIS_RS_PDC, 0x15d6, "PDC_GPU_TCS3_CONTROL", 0, 0 },
+	{ POLARIS_RS_PDC, 0x15d9, "PDC_GPU_TCS3_CMD0_MSGID", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x15da, "PDC_GPU_TCS3_CMD0_ADDR", 0x30010, 0 },
+	{ POLARIS_RS_PDC, 0x15db, "PDC_GPU_TCS3_CMD0_DATA", 2, 0 },
+	{ POLARIS_RS_PDC, 0x15dd, "PDC_GPU_TCS3_CMD0_MSGID+4", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x15de, "PDC_GPU_TCS3_CMD0_ADDR+4", 0x30000, 0 },
+	{ POLARIS_RS_PDC, 0x15df, "PDC_GPU_TCS3_CMD0_DATA+4", 3, 0 },
+	{ POLARIS_RS_PDC, 0x15e1, "PDC_GPU_TCS3_CMD0_MSGID+8", 0x10108, 0 },
+	{ POLARIS_RS_PDC, 0x15e2, "PDC_GPU_TCS3_CMD0_ADDR+8", 0x30080, 0 },
+	{ POLARIS_RS_PDC, 0x15e3, "PDC_GPU_TCS3_CMD0_DATA+8", 3, 0 },
+	{ POLARIS_RS_PDC, 0x1148, "PDC_GPU_SEQ_START_ADDR", 0, 0 },
+	{ POLARIS_RS_PDC, 0x1140, "PDC_GPU_ENABLE_PDC", 0x80000001u, 0 },
+};
+#define POLARIS_RS_COUNT ((uint32_t)(sizeof(polaris_rs_writes) / sizeof(polaris_rs_writes[0])))
+
+static vm_offset_t polaris_rs_region[3];
+static uint32_t polaris_rs_written;
+static bool polaris_rs_saved;
+static uint32_t polaris_rs_old_enable;
+
+static vm_offset_t
+polaris_rs_address(const struct polaris_rs_write *w)
+{
+	return polaris_rs_region[w->region] + 4u * w->word;
+}
+
+/* Which bits read back as written: some words follow the match values or drop bit 3. */
+static uint32_t
+polaris_rs_mask(const struct polaris_rs_write *w)
+{
+	if (w->region == POLARIS_RS_RSCC && (w->word == 0x000d || w->word == 0x000f || w->word == 0x0011)) {
+		return 0;
+	}
+	if (w->region == POLARIS_RS_PDC && (w->word == 0x1575 || w->word == 0x1579 || w->word == 0x157d ||
+	    w->word == 0x15d9 || w->word == 0x15dd || w->word == 0x15e1)) {
+		return ~0x8u;
+	}
+	return ~0u;
+}
+
+static bool
+polaris_rs_restore(uint32_t count)
+{
+	uint32_t different = 0, i;
+
+	if (!polaris_rs_saved) {
+		return true;
+	}
+	polaris_wr(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140,
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140) & ~1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140) & 1u) {
+		POLARIS_LOG("polaris-gpu: step 11 PDC did not disable; tables not changed\n");
+		return false;
+	}
+	while (polaris_rs_written > 0) {
+		struct polaris_rs_write *w = &polaris_rs_writes[--polaris_rs_written];
+
+		if (!(w->region == POLARIS_RS_PDC && w->word == 0x1140)) {
+			polaris_wr(polaris_rs_address(w), w->old);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	polaris_wr(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140, polaris_rs_old_enable);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (i = 0; i < count; i++) {
+		struct polaris_rs_write *w = &polaris_rs_writes[i];
+		uint32_t back = polaris_rd(polaris_rs_address(w));
+
+		if ((back ^ w->old) & polaris_rs_mask(w)) {
+			POLARIS_LOG("polaris-gpu: step 11 restore mismatch %s: wanted %#010x got %#010x\n",
+			    w->name, w->old, back);
+			different++;
+		}
+	}
+	if (polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140) != polaris_rs_old_enable) {
+		different++;
+	}
+	POLARIS_LOG("polaris-gpu: step 11 RSC/PDC restored %s (%u entries); ENABLE_PDC %#010x\n",
+	    different ? "FAIL" : "PASS", count,
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140));
+	polaris_rs_saved = false;
+	return different == 0;
+}
+
+/* step 11: program the GPU's RPMh sequencer, verify it, then put it back */
+static bool
+polaris_step_rsc_pdc(void)
+{
+	uint32_t different = 0, i;
+	bool ok;
+
+	if (polaris_gmu_base == 0 || !polaris_gmu_clk_on) {
+		POLARIS_LOG("polaris-gpu: the GMU is not mapped or its clock is off: RSC not touched\n");
+		return false;
+	}
+	polaris_rs_region[POLARIS_RS_RSCC] = polaris_gmu_base + POLARIS_RSCC_OFFSET;
+	POLARIS_LOG("polaris-gpu: step 11 RSC at GMU+%#x: STATUS0 %#010x, SEQ_BUSY %#010x, SEQ_START %#010x\n",
+	    POLARIS_RSCC_OFFSET, polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x4),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x101),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x8));
+	polaris_log_barrier();
+	polaris_rs_region[POLARIS_RS_PDC] = ml_io_map(POLARIS_PDC_PHYS, POLARIS_PDC_SIZE);
+	polaris_rs_region[POLARIS_RS_SEQ] = ml_io_map(POLARIS_PDC_SEQ_PHYS, POLARIS_PDC_SIZE);
+	POLARIS_LOG("polaris-gpu: step 11 PDC ENABLE %#010x, SEQ_START %#010x, TCS1 %#010x, TCS3 %#010x, seqmem %#010x %#010x\n",
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1148),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1572),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x15d6),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_SEQ]), polaris_rd(polaris_rs_region[POLARIS_RS_SEQ] + 4));
+	polaris_log_barrier();
+
+	/* A previous interrupted run may leave the PDC enabled: never edit live tables. */
+	if (polaris_rd(polaris_gmu_base + 4 * 0x5000) != 1 ||
+	    (polaris_rd(polaris_gpucc + POLARIS_GPUCC_GX_GDSCR) & (POLARIS_GDSC_PWR_ON | POLARIS_GDSCR_SW_COLLAPSE)) !=
+	    POLARIS_GDSCR_SW_COLLAPSE ||
+	    polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x101) != 0) {
+		POLARIS_LOG("polaris-gpu: step 11 RSC/PDC not idle (GMU reset / GX off / SEQ_BUSY): no programming\n");
+		return false;
+	}
+
+	for (i = 0; i < POLARIS_RS_COUNT; i++) {
+		polaris_rs_writes[i].old = polaris_rd(polaris_rs_address(&polaris_rs_writes[i]));
+	}
+	polaris_rs_old_enable = polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140);
+	polaris_rs_saved = true;
+	polaris_wr(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140, polaris_rs_old_enable & ~1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	POLARIS_LOG("polaris-gpu: step 11 PDC disabled for programming: %#010x (was %#010x)\n",
+	    polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140), polaris_rs_old_enable);
+	if (polaris_rd(polaris_rs_region[POLARIS_RS_PDC] + 4 * 0x1140) & 1u) {
+		return false;
+	}
+	polaris_log_barrier();
+	for (i = 0; i < POLARIS_RS_COUNT; i++) {
+		struct polaris_rs_write *w = &polaris_rs_writes[i];
+		uint32_t back;
+		bool same;
+
+		polaris_wr(polaris_rs_address(w), w->value);
+		polaris_rs_written = i + 1;
+		back = polaris_rd(polaris_rs_address(w));
+		same = ((back ^ w->value) & polaris_rs_mask(w)) == 0;
+		if (!same) {
+			different++;
+		}
+		POLARIS_LOG("polaris-gpu: step 11   %-40s was %#010x wrote %#010x read %#010x%s\n",
+		    w->name, w->old, w->value, back, same ? "" : "  DIFFERENT");
+	}
+	POLARIS_LOG("polaris-gpu: step 11 RSC after: STATUS0 %#010x, SEQ_BUSY %#010x, %u of %u entries different\n",
+	    polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x4),
+	    polaris_rd(polaris_rs_region[POLARIS_RS_RSCC] + 4 * 0x101), different, POLARIS_RS_COUNT);
+	polaris_log_barrier();
+	ok = (different == 0) && polaris_rs_restore(POLARIS_RS_COUNT);
+	polaris_log_barrier();
+	return ok;
+}
+
 void
 PE_init_iokit(void)
 {
