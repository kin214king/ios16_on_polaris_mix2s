diff --git a/bsd/miscfs/apfs/apfs_kmount.c b/bsd/miscfs/apfs/apfs_kmount.c
new file mode 100644
index 0000000..246fccf
--- /dev/null
+++ b/bsd/miscfs/apfs/apfs_kmount.c
@@ -0,0 +1,85 @@
+/*
+ * polaris M4: mount the APFS partition as a filesystem, not just read it.
+ *
+ * The APFS driver takes the path of a block device as its mount data (see apfs_mount()
+ * in apfs_vfsops.c) and opens it itself, so all this needs is a device node whose
+ * blocks are the partition: sweet_ufs makes /dev/apfsroot0 for it, and the mount is
+ * the ordinary kernel_mount() the driver already supports.
+ *
+ * Called from bsd_init() once devfs and the root are up.  Gated by boot-arg
+ * polarisapfs=<partition name>; mounts read only, and looks the system version file up
+ * through the mount so the log says whether the filesystem really answers.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <pexpert/pexpert.h>
+
+/* bsd/vfs/vfs_syscalls.c: the mount path of kernel mounts */
+extern int kernel_mount(const char *fstype, vnode_t pvp, vnode_t vp, const char *path,
+    void *data, size_t datalen, int syscall_flags, uint32_t kern_flags, vfs_context_t ctx);
+
+/* bsd/dev/sweet_ufs.c: makes the partition's device node, answers its path */
+extern int sweet_ufs_apfs_node(const char *name, char *path, size_t pathlen);
+
+/* Where the volume is mounted: the first of these that exists and is empty. */
+static const char *polaris_apfs_points[] = {
+	"/cores",
+	"/private/var/tmp",
+	"/private/var",
+	NULL,
+};
+
+int
+polaris_apfs_mount(void)
+{
+	char part[32] = "";
+	char dev[64] = "";
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error, i;
+
+	if (!PE_parse_boot_argn("polarisapfs", part, sizeof(part)) || part[0] == 0) {
+		return 0;
+	}
+	error = sweet_ufs_apfs_node(part, dev, sizeof(dev));
+	if (error) {
+		printf("POLARIS APFS: partition \"%s\": %d\n", part, error);
+		return error;
+	}
+	for (i = 0; polaris_apfs_points[i] != NULL; i++) {
+		error = vnode_lookup(polaris_apfs_points[i], 0, &vp, ctx);
+		if (error == 0) {
+			vnode_put(vp);
+			vp = NULLVP;
+			break;
+		}
+	}
+	if (polaris_apfs_points[i] == NULL) {
+		printf("POLARIS APFS: no mount point (last error %d)\n", error);
+		return error;
+	}
+	error = kernel_mount("apfs", NULLVP, NULLVP, polaris_apfs_points[i], (void *)dev, 0,
+	    MNT_RDONLY, 0, ctx);
+	printf("POLARIS APFS: mount \"%s\" on %s -> %d\n", dev, polaris_apfs_points[i], error);
+	if (error != 0) {
+		return error;
+	}
+	{
+		char path[MAXPATHLEN];
+
+		snprintf(path, sizeof(path), "%s/System/Library/CoreServices/SystemVersion.plist",
+		    polaris_apfs_points[i]);
+		error = vnode_lookup(path, 0, &vp, ctx);
+		printf("POLARIS APFS: lookup %s through the mount -> %d\n", path, error);
+		if (error == 0) {
+			vnode_put(vp);
+		}
+	}
+	return error;
+}
