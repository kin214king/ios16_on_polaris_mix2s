+/*
+ * polaris M4: give a GPT partition a block device node of its own, for the APFS driver to
+ * open.  The root's extents are put back before returning, so the root device keeps
+ * working; the new node reads through sweet_ufs_extents().
+ */
+int
+sweet_ufs_apfs_node(const char *name, char *path, size_t pathlen)
+{
+	uint64_t root_first = su.first_block, root_blocks = su.nblocks;
+	dev_t dev;
+	int error;
+
+	if (!su.ready) {
+		return ENXIO;
+	}
+	error = ufs_find_partition(name);
+	if (error) {
+		return error;
+	}
+	su_apfs_first = su.first_block;
+	su_apfs_blocks = su.nblocks;
+	su.first_block = root_first;
+	su.nblocks = root_blocks;
+
+	dev = makedev(su.bmajor, SWEET_UFS_APFS_MINOR);
+	error = devfs_make_node(dev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "apfsroot0");
+	if (error) {
+		printf("POLARIS APFS: no device node for \"%s\": %d\n", name, error);
+		return error;
+	}
+	snprintf(path, pathlen, "/dev/apfsroot0");
+	printf("POLARIS APFS: \"%s\" = /dev/apfsroot0, %llu blocks of %u bytes\n",
+	    name, su_apfs_blocks, UFS_BLOCK);
+	return 0;
+}
