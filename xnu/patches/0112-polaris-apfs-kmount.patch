+/*
+ * polaris M4: the APFS partition is a second device of the same driver (minor 1), so
+ * requests say which partition they mean.  Everything but that node is the root.
+ */
+#define SWEET_UFS_APFS_MINOR 1
+
+static uint64_t su_apfs_first, su_apfs_blocks;
+
+static void
+sweet_ufs_extents(dev_t dev, uint64_t *first, uint64_t *blocks)
+{
+	if (minor(dev) == SWEET_UFS_APFS_MINOR && su_apfs_blocks != 0) {
+		*first = su_apfs_first;
+		*blocks = su_apfs_blocks;
+	} else {
+		*first = su.first_block;
+		*blocks = su.nblocks;
+	}
+}
