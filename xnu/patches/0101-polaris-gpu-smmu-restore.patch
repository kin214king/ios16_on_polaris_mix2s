 /* put the thirteen registers back; returns true only when every one reads back */
+
+/* The SMMU's global registers (SMR/S2CR/CBAR/CBA2R) sometimes need more than one
+ * store to take while the context bank is winding down; write, wait, read back. */
+static bool
+polaris_smmu_global_write(vm_offset_t address, uint32_t value, const char *what)
+{
+	int attempt;
+
+	for (attempt = 0; attempt < 5; attempt++) {
+		polaris_wr(address, value);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (polaris_rd(address) == value) {
+			return true;
+		}
+		polaris_sleep_us(2000);
+	}
+	POLARIS_LOG("polaris-gpu: step 12 %s did not take %#010x (reads %#010x)\n", what, value,
+	    polaris_rd(address));
+	return false;
+}
