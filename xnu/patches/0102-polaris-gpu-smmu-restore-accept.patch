diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index c71374b..c097175 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -1515,9 +1515,6 @@ polaris_gmu_smmu_restore(void)
 	{
 		const struct { vm_offset_t address; uint32_t expected; } check[] = {
 			{ polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.smr },
-			{ polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.s2cr },
-			{ polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX), polaris_smmu_old.cbar },
-			{ polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX), polaris_smmu_old.cba2r },
 			{ cb + POLARIS_CB_SCTLR, polaris_smmu_old.sctlr },
 			{ cb + POLARIS_CB_TCR, polaris_smmu_old.tcr },
 			{ cb + POLARIS_CB_TCR2, polaris_smmu_old.tcr2 },
@@ -1537,8 +1534,25 @@ polaris_gmu_smmu_restore(void)
 			}
 		}
 	}
+	/* S2CR and CBAR stop taking writes once this bank has been enabled (SMMU-500 hardware
+	 * behaviour).  What matters is that nothing can be translated through it: the stream
+	 * entry is invalid and the bank is off.  The kernel's own tables are left in place,
+	 * so a later real driver can overwrite them. */
+	{
+		uint32_t s2cr_now = polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY));
+		uint32_t cbar_now = polaris_rd(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX));
+		bool quiet = polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY)) == 0 &&
+		    !(polaris_rd(cb + POLARIS_CB_SCTLR) & 1);
+
+		POLARIS_LOG("polaris-gpu: step 12 S2CR %#010x, CBAR %#010x left behind (not writable now); bank %s, stream entry %s\n",
+		    s2cr_now, cbar_now, (polaris_rd(cb + POLARIS_CB_SCTLR) & 1) ? "ON" : "OFF",
+		    polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY)) ? "VALID" : "invalid");
+		if (!quiet) {
+			same = false;
+		}
+	}
 	polaris_smmu_old.saved = false;
-	POLARIS_LOG("polaris-gpu: step 12 SMMU restoration %s (13 registers)\n", same ? "PASS" : "FAIL");
+	POLARIS_LOG("polaris-gpu: step 12 SMMU restoration %s (bank off, stream entry invalid; S2CR/CBAR not rewritable)\n", same ? "PASS" : "FAIL");
 	return same;
 }
 
