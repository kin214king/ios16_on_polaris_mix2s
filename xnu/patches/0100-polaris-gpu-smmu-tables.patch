+/* ---- polaris P1b-6: the GMU's address space in the SMMU (dipper step 12) ----------------
+ *
+ * The GMU (the GPU's own Cortex-M3) does not see physical addresses: it sees the
+ * addresses its SMMU context bank translates.  This step builds a three-level table
+ * mapping the four regions the GMU firmware uses (dummy, debug, log, hfi) into memory
+ * of ours, points a free context bank and an empty stream entry at it, and asks the
+ * SMMU's own ATOS mechanism to translate every page: a mismatch, a fault on an
+ * unmapped hole, or a translation of one is a failure.  Everything is put back at the
+ * end, so the step is repeatable and leaves the hardware as it was.
+ *
+ * Memory: static pages in the kernel's data segment (kvtophys() maps them like any
+ * other kernel address), so nothing is allocated at this point of the boot.
+ *
+ * Gated by boot-arg polarisgpu=12 (steps 1-11 run first).
+ */
+
+#define POLARIS_CB_TTBR1_LO      0x28
+#define POLARIS_CB_TTBR1_HI      0x2c
+#define POLARIS_CB_MAIR1         0x3c
+#define POLARIS_CB_PAR           0x50
+#define POLARIS_CB_TLBIASID      0x610
+#define POLARIS_CB_TLBSYNC       0x7f0
+#define POLARIS_CB_TLBSTATUS     0x7f4
+#define POLARIS_CB_ATS1PR        0x800
+#define POLARIS_CB_ATSR          0x8f0
+
+#define POLARIS_PTE_TABLE       3ull
+#define POLARIS_PTE_PAGE        3ull
+#define POLARIS_PTE_SHARED      (2ull << 8)
+#define POLARIS_PTE_ACCESSED    (1ull << 10)
+#define POLARIS_PTE_NOT_GLOBAL  (1ull << 11)
+#define POLARIS_PTE_ADDRESS     0x0000fffffffff000ull
+/* memory attribute 0: not cached (the GMU reads its regions from memory, not from our cache) */
+#define POLARIS_PTE_GMU         (POLARIS_PTE_SHARED | POLARIS_PTE_ACCESSED | POLARIS_PTE_NOT_GLOBAL)
+
+#define POLARIS_SMR_VALID       (1u << 31)
+#define POLARIS_GMU_STREAM      5u      /* both SDM845 device trees: SID 5, no mask */
+#define POLARIS_GMU_CTX         2u      /* context bank 2 is free on this SMMU (steps 7/8: 0 of 5 in use) */
+#define POLARIS_GMU_SMR_ENTRY   0u
+#define POLARIS_CBAR_STAGE_1    (1u << 16 | 3u << 8 | 0xfu << 12)
+#define POLARIS_CBA2R_64_BIT    1u
+#define POLARIS_SCTLR_ON        (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12)
+#define POLARIS_TCR_39_BITS     (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define POLARIS_TCR2_36_BITS    (1u | 1u << 4 | 7u << 15)
+#define POLARIS_MAIR0_LINUX     0xf404ff44u     /* attribute 0 not cached, 1 cached, 2 device */
+#define POLARIS_FSR_ALL         0xc00001feu
+
+extern uint64_t kvtophys(vm_offset_t va);
+
+struct polaris_gmu_region {
+	const char *name;
+	uint64_t address;               /* what the GMU sees */
+	uint32_t size;
+	uint8_t *memory;                /* what we write into, contiguous by construction */
+};
+
+static uint8_t polaris_gmu_page_dummy[0x1000] __attribute__((aligned(0x1000)));
+static uint8_t polaris_gmu_page_debug[0x4000] __attribute__((aligned(0x1000)));
+static uint8_t polaris_gmu_page_log[0x4000] __attribute__((aligned(0x1000)));
+static uint8_t polaris_gmu_page_hfi[0x4000] __attribute__((aligned(0x1000)));
+static uint8_t polaris_gmu_tables[3][0x1000] __attribute__((aligned(0x1000)));
+
+static struct polaris_gmu_region polaris_gmu_regions[] = {
+	{ "dummy", 0x60000000ull, 0x1000, polaris_gmu_page_dummy },
+	{ "debug", 0x60001000ull, 0x4000, polaris_gmu_page_debug },
+	{ "log",   0x60005000ull, 0x4000, polaris_gmu_page_log },
+	{ "hfi",   0x60009000ull, 0x4000, polaris_gmu_page_hfi },
+};
+#define POLARIS_GMU_REGIONS (sizeof(polaris_gmu_regions) / sizeof(polaris_gmu_regions[0]))
+
+static struct {
+	bool saved;
+	uint32_t smr, s2cr, cbar, cba2r, sctlr, tcr, tcr2, ttbr0_lo, ttbr0_hi, ttbr1_lo, ttbr1_hi, mair0, mair1;
+} polaris_smmu_old;
+
+static vm_offset_t
+polaris_smmu_cb(uint32_t n)
+{
+	return polaris_smmu + polaris_smmu_pages_cb_base + polaris_smmu_page_size * n;
+}
+
+/* The SMMU reads the tables from memory, not from this processor's cache. */
+static void
+polaris_to_memory(vm_offset_t start, vm_size_t size)
+{
+	vm_offset_t line;
+
+	for (line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* A timeout is not evidence that an unmapped address was rejected. */
+enum polaris_smmu_result { POLARIS_SMMU_TIMEOUT = -1, POLARIS_SMMU_FAULT = 0, POLARIS_SMMU_TRANSLATED = 1 };
+
+static enum polaris_smmu_result
+polaris_smmu_translate(uint32_t ctx, uint64_t iova, uint64_t *phys)
+{
+	vm_offset_t cb = polaris_smmu_cb(ctx);
+	uint64_t par = 0;
+	int i;
+
+	*phys = 0;
+	polaris_wr(cb + POLARIS_CB_ATS1PR, (uint32_t)(iova & ~0xfffull));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (i = 0; i < 100 && (polaris_rd(cb + POLARIS_CB_ATSR) & 1); i++) {
+		polaris_sleep_us(10);
+	}
+	if (polaris_rd(cb + POLARIS_CB_ATSR) & 1) {
+		return POLARIS_SMMU_TIMEOUT;
+	}
+	{
+		uint32_t lo = polaris_rd(cb + POLARIS_CB_PAR);
+		uint32_t hi = polaris_rd(cb + POLARIS_CB_PAR + 4);
+		par = ((uint64_t)hi << 32) | lo;
+	}
+	if (par & 1) {
+		return POLARIS_SMMU_FAULT;
+	}
+	*phys = par & POLARIS_PTE_ADDRESS;
+	return POLARIS_SMMU_TRANSLATED;
+}
+
+/* put the thirteen registers back; returns true only when every one reads back */
+static bool
+polaris_gmu_smmu_restore(void)
+{
+	vm_offset_t cb;
+	const struct { vm_offset_t address; uint32_t expected; } restored[] = {
+		{ polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), 0 },
+		{ polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY), 0 },
+	};
+	uint32_t i;
+	bool same = true;
+
+	if (!polaris_smmu_old.saved) {
+		return true;
+	}
+	cb = polaris_smmu_cb(POLARIS_GMU_CTX);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), 0);
+	(void)restored;
+	polaris_wr(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.s2cr);
+	polaris_wr(cb + POLARIS_CB_SCTLR, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	polaris_wr(cb + POLARIS_CB_TLBIASID, POLARIS_GMU_CTX);
+	polaris_wr(cb + POLARIS_CB_TLBSYNC, 1);
+	for (i = 0; i < 100 && (polaris_rd(cb + POLARIS_CB_TLBSTATUS) & 1); i++) {
+		polaris_sleep_us(10);
+	}
+	polaris_wr(cb + POLARIS_CB_TCR, polaris_smmu_old.tcr);
+	polaris_wr(cb + POLARIS_CB_TCR2, polaris_smmu_old.tcr2);
+	polaris_wr(cb + POLARIS_CB_TTBR0_LO, polaris_smmu_old.ttbr0_lo);
+	polaris_wr(cb + POLARIS_CB_TTBR0_HI, polaris_smmu_old.ttbr0_hi);
+	polaris_wr(cb + POLARIS_CB_TTBR1_LO, polaris_smmu_old.ttbr1_lo);
+	polaris_wr(cb + POLARIS_CB_TTBR1_HI, polaris_smmu_old.ttbr1_hi);
+	polaris_wr(cb + POLARIS_CB_MAIR0, polaris_smmu_old.mair0);
+	polaris_wr(cb + POLARIS_CB_MAIR1, polaris_smmu_old.mair1);
+	polaris_wr(cb + POLARIS_CB_FSR, POLARIS_FSR_ALL);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX), polaris_smmu_old.cbar);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX), polaris_smmu_old.cba2r);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.smr);
+	polaris_wr(cb + POLARIS_CB_SCTLR, polaris_smmu_old.sctlr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	{
+		const struct { vm_offset_t address; uint32_t expected; } check[] = {
+			{ polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.smr },
+			{ polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY), polaris_smmu_old.s2cr },
+			{ polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX), polaris_smmu_old.cbar },
+			{ polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX), polaris_smmu_old.cba2r },
+			{ cb + POLARIS_CB_SCTLR, polaris_smmu_old.sctlr },
+			{ cb + POLARIS_CB_TCR, polaris_smmu_old.tcr },
+			{ cb + POLARIS_CB_TCR2, polaris_smmu_old.tcr2 },
+			{ cb + POLARIS_CB_TTBR0_LO, polaris_smmu_old.ttbr0_lo },
+			{ cb + POLARIS_CB_TTBR0_HI, polaris_smmu_old.ttbr0_hi },
+			{ cb + POLARIS_CB_TTBR1_LO, polaris_smmu_old.ttbr1_lo },
+			{ cb + POLARIS_CB_TTBR1_HI, polaris_smmu_old.ttbr1_hi },
+			{ cb + POLARIS_CB_MAIR0, polaris_smmu_old.mair0 },
+			{ cb + POLARIS_CB_MAIR1, polaris_smmu_old.mair1 },
+		};
+		for (i = 0; i < sizeof(check) / sizeof(check[0]); i++) {
+			uint32_t back = polaris_rd(check[i].address);
+			if (back != check[i].expected) {
+				POLARIS_LOG("polaris-gpu: step 12 restore mismatch %#lx expected %#x read %#x\n",
+				    (unsigned long)(check[i].address - polaris_smmu), check[i].expected, back);
+				same = false;
+			}
+		}
+	}
+	polaris_smmu_old.saved = false;
+	POLARIS_LOG("polaris-gpu: step 12 SMMU restoration %s (13 registers)\n", same ? "PASS" : "FAIL");
+	return same;
+}
+
+/* step 12: the GMU's address space */
+static bool
+polaris_step_gmu_smmu(void)
+{
+	uint64_t *l1 = (uint64_t *)polaris_gmu_tables[0];
+	uint64_t *l2 = (uint64_t *)polaris_gmu_tables[1];
+	uint64_t *l3 = (uint64_t *)polaris_gmu_tables[2];
+	uint64_t root, phys, expected;
+	vm_offset_t cb;
+	uint32_t wrong = 0, pages = 0, r, off, i;
+	bool ok = false;
+
+	if (polaris_smmu == 0 || polaris_gmu_base == 0) {
+		POLARIS_LOG("polaris-gpu: step 12 the SMMU/GMU was not read (steps 6/7)\n");
+		return false;
+	}
+	cb = polaris_smmu_cb(POLARIS_GMU_CTX);
+
+	/* preconditions: the M3 is held in reset, the GX half is off, the bank is untouched */
+	if (polaris_rd(polaris_gmu_base + 4u * 0x5000) != 1 ||
+	    (polaris_rd(polaris_gpucc + 0x100c) & (1u << 31)) ||
+	    polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY)) != 0x200ff ||
+	    polaris_rd(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX)) != 0 ||
+	    polaris_rd(cb + POLARIS_CB_SCTLR) != 0) {
+		POLARIS_LOG("polaris-gpu: step 12 preconditions not met: S2CR %#x CBAR %#x SCTLR %#x GMU %#x\n",
+		    polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY)),
+		    polaris_rd(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX)),
+		    polaris_rd(cb + POLARIS_CB_SCTLR), polaris_rd(polaris_gmu_base + 4u * 0x5000));
+		return false;
+	}
+	for (i = 0; i < polaris_smmu_num_smr; i++) {
+		if (polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(i)) != 0) {
+			POLARIS_LOG("polaris-gpu: step 12 stream entry %u is not empty\n", i);
+			return false;
+		}
+	}
+
+	/* three tables: level 1 (bits 38:30), level 2 (29:21), level 3 (20:12); one 2 MB window covers every region */
+	__builtin_memset(polaris_gmu_tables, 0, sizeof(polaris_gmu_tables));
+	root = kvtophys((vm_offset_t)l1);
+	for (r = 0; r < POLARIS_GMU_REGIONS; r++) {
+		struct polaris_gmu_region *g = &polaris_gmu_regions[r];
+
+		if ((g->address >> 30) != (polaris_gmu_regions[0].address >> 30) ||
+		    (g->address >> 21) != (polaris_gmu_regions[0].address >> 21) ||
+		    ((g->address + g->size - 1) >> 21) != (polaris_gmu_regions[0].address >> 21)) {
+			POLARIS_LOG("polaris-gpu: step 12 %s is outside the 2 MB window\n", g->name);
+			return false;
+		}
+		l1[(g->address >> 30) & 0x1ff] = kvtophys((vm_offset_t)l2) | POLARIS_PTE_TABLE;
+		l2[(g->address >> 21) & 0x1ff] = kvtophys((vm_offset_t)l3) | POLARIS_PTE_TABLE;
+		for (off = 0; off < g->size; off += 0x1000) {
+			l3[((g->address + off) >> 12) & 0x1ff] =
+			    (kvtophys((vm_offset_t)g->memory) + off) | POLARIS_PTE_GMU | POLARIS_PTE_PAGE;
+			pages++;
+		}
+		polaris_to_memory((vm_offset_t)g->memory, g->size);
+		POLARIS_LOG("polaris-gpu: step 12 %s: the GMU sees %#llx..%#llx in memory at %#llx\n",
+		    g->name, g->address, g->address + g->size - 1, kvtophys((vm_offset_t)g->memory));
+	}
+	polaris_to_memory((vm_offset_t)polaris_gmu_tables, sizeof(polaris_gmu_tables));
+	POLARIS_LOG("polaris-gpu: step 12 tables at %#llx (level 1), %u pages\n", root, pages);
+
+	/* remember what is there */
+	polaris_smmu_old.smr = polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY));
+	polaris_smmu_old.s2cr = polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY));
+	polaris_smmu_old.cbar = polaris_rd(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX));
+	polaris_smmu_old.cba2r = polaris_rd(polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX));
+	polaris_smmu_old.sctlr = polaris_rd(cb + POLARIS_CB_SCTLR);
+	polaris_smmu_old.tcr = polaris_rd(cb + POLARIS_CB_TCR);
+	polaris_smmu_old.tcr2 = polaris_rd(cb + POLARIS_CB_TCR2);
+	polaris_smmu_old.ttbr0_lo = polaris_rd(cb + POLARIS_CB_TTBR0_LO);
+	polaris_smmu_old.ttbr0_hi = polaris_rd(cb + POLARIS_CB_TTBR0_HI);
+	polaris_smmu_old.ttbr1_lo = polaris_rd(cb + POLARIS_CB_TTBR1_LO);
+	polaris_smmu_old.ttbr1_hi = polaris_rd(cb + POLARIS_CB_TTBR1_HI);
+	polaris_smmu_old.mair0 = polaris_rd(cb + POLARIS_CB_MAIR0);
+	polaris_smmu_old.mair1 = polaris_rd(cb + POLARIS_CB_MAIR1);
+	polaris_smmu_old.saved = true;
+	POLARIS_LOG("polaris-gpu: step 12 before: SMR %#010x S2CR %#010x CBAR %#010x SCTLR %#010x TTBR0 %#010x%08x\n",
+	    polaris_smmu_old.smr, polaris_smmu_old.s2cr, polaris_smmu_old.cbar, polaris_smmu_old.sctlr,
+	    polaris_smmu_old.ttbr0_hi, polaris_smmu_old.ttbr0_lo);
+
+	/* arm-smmu.c: the context is completed and tagged before it is switched on, then the stream is sent to it */
+	root |= (uint64_t)POLARIS_GMU_CTX << 48;
+	polaris_wr(cb + POLARIS_CB_SCTLR, 0);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX), POLARIS_CBA2R_64_BIT);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX), POLARIS_CBAR_STAGE_1);
+	polaris_wr(cb + POLARIS_CB_TCR2, POLARIS_TCR2_36_BITS);
+	polaris_wr(cb + POLARIS_CB_TCR, POLARIS_TCR_39_BITS);
+	polaris_wr(cb + POLARIS_CB_TTBR0_LO, (uint32_t)root);
+	polaris_wr(cb + POLARIS_CB_TTBR0_HI, (uint32_t)(root >> 32));
+	polaris_wr(cb + POLARIS_CB_TTBR1_LO, 0);
+	polaris_wr(cb + POLARIS_CB_TTBR1_HI, 0);
+	polaris_wr(cb + POLARIS_CB_MAIR0, POLARIS_MAIR0_LINUX);
+	polaris_wr(cb + POLARIS_CB_MAIR1, 0);
+	polaris_wr(cb + POLARIS_CB_FSR, POLARIS_FSR_ALL);
+	polaris_wr(cb + POLARIS_CB_TLBIASID, POLARIS_GMU_CTX);
+	polaris_wr(cb + POLARIS_CB_TLBSYNC, 1);
+	for (i = 0; i < 100 && (polaris_rd(cb + POLARIS_CB_TLBSTATUS) & 1); i++) {
+		polaris_sleep_us(10);
+	}
+	if (polaris_rd(cb + POLARIS_CB_TLBSTATUS) & 1) {
+		POLARIS_LOG("polaris-gpu: step 12 the SMMU does not finish forgetting old translations (%#x)\n",
+		    polaris_rd(cb + POLARIS_CB_TLBSTATUS));
+		goto out;
+	}
+	polaris_wr(cb + POLARIS_CB_SCTLR, POLARIS_SCTLR_ON);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY), POLARIS_GMU_CTX);
+	polaris_wr(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY), POLARIS_SMR_VALID | POLARIS_GMU_STREAM);
+	POLARIS_LOG("polaris-gpu: step 12 context bank %u: CBAR %#010x CBA2R %#x SCTLR %#010x TTBR0 %#010x%08x\n",
+	    POLARIS_GMU_CTX, polaris_rd(polaris_smmu + POLARIS_SMMU_CBAR(POLARIS_GMU_CTX)),
+	    polaris_rd(polaris_smmu + POLARIS_SMMU_CBA2R(POLARIS_GMU_CTX)), polaris_rd(cb + POLARIS_CB_SCTLR),
+	    polaris_rd(cb + POLARIS_CB_TTBR0_HI), polaris_rd(cb + POLARIS_CB_TTBR0_LO));
+	POLARIS_LOG("polaris-gpu: step 12 stream entry %u: SMR %#010x S2CR %#010x\n", POLARIS_GMU_SMR_ENTRY,
+	    polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY)),
+	    polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY)));
+	polaris_log_barrier();
+
+	if (polaris_rd(polaris_smmu + POLARIS_SMMU_SMR(POLARIS_GMU_SMR_ENTRY)) !=
+	    (POLARIS_SMR_VALID | POLARIS_GMU_STREAM) ||
+	    (polaris_rd(polaris_smmu + POLARIS_SMMU_S2CR(POLARIS_GMU_SMR_ENTRY)) & 0x300ff) != POLARIS_GMU_CTX ||
+	    !(polaris_rd(cb + POLARIS_CB_SCTLR) & 1) ||
+	    polaris_rd(cb + POLARIS_CB_TTBR0_LO) != (uint32_t)root) {
+		POLARIS_LOG("polaris-gpu: step 12 the SMMU did not take what was written\n");
+		goto out;
+	}
+
+	/* what the SMMU makes of every page of the regions, and of two addresses nothing maps */
+	for (r = 0; r < POLARIS_GMU_REGIONS; r++) {
+		uint32_t prior_wrong = wrong;
+
+		for (off = 0; off < polaris_gmu_regions[r].size; off += 0x1000) {
+			expected = kvtophys((vm_offset_t)polaris_gmu_regions[r].memory) + off;
+			if (polaris_smmu_translate(POLARIS_GMU_CTX, polaris_gmu_regions[r].address + off, &phys) !=
+			    POLARIS_SMMU_TRANSLATED || phys != expected) {
+				wrong++;
+				POLARIS_LOG("polaris-gpu: step 12   %s +%#x: expected %#llx, the SMMU says %#llx\n",
+				    polaris_gmu_regions[r].name, off, expected, phys);
+			}
+		}
+		POLARIS_LOG("polaris-gpu: step 12 %s: %u of %u pages wrong\n", polaris_gmu_regions[r].name,
+		    wrong - prior_wrong, polaris_gmu_regions[r].size / 0x1000);
+	}
+	{
+		const uint64_t holes[] = { 0x60100000ull, 0x00001000ull };
+		for (i = 0; i < 2; i++) {
+			enum polaris_smmu_result result = polaris_smmu_translate(POLARIS_GMU_CTX, holes[i], &phys);
+
+			POLARIS_LOG("polaris-gpu: step 12 unmapped %#llx: %s\n", holes[i],
+			    result == POLARIS_SMMU_FAULT ? "explicit translation fault" :
+			    result == POLARIS_SMMU_TIMEOUT ? "TIMEOUT -- FAIL" : "TRANSLATED -- FAIL");
+			if (result != POLARIS_SMMU_FAULT) {
+				wrong++;
+			}
+		}
+	}
+	POLARIS_LOG("polaris-gpu: step 12 context fault status %#010x, global %#010x\n",
+	    polaris_rd(cb + POLARIS_CB_FSR), polaris_rd(polaris_smmu + POLARIS_SMMU_SGFSR));
+	POLARIS_LOG("polaris-gpu: step 12 %u of %u pages translated wrong\n", wrong, pages);
+	ok = wrong == 0;
+
+out:
+	{
+		bool restored = polaris_gmu_smmu_restore();
+
+		if (!restored) {
+			POLARIS_LOG("polaris-gpu: step 12 WARNING: the SMMU was not put back\n");
+			return false;
+		}
+	}
+	POLARIS_LOG("polaris-gpu: step 12 the GMU address space %s\n", ok ? "PASS" : "FAIL");
+	polaris_log_barrier();
+	return ok;
+}
