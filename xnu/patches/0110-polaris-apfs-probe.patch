+/*
+ * Bytes of the probed partition for apfs_lib (bsd/miscfs/apfs/apfs_probe.c): whole
+ * buffers, block aligned.  ctx is that partition's first block.
+ */
+static int
+sweet_ufs_apfs_read(void *ctx, uint64_t off, void *buf, size_t len)
+{
+	uint64_t base = *(const uint64_t *)ctx;
+	uint8_t *out = buf;
+	int error;
+
+	if ((off & (UFS_BLOCK - 1)) != 0 || len == 0) {
+		return EINVAL;
+	}
+	while (len > 0) {
+		uint32_t blocks = (uint32_t)MIN(len / UFS_BLOCK, BOUNCE_SIZE / UFS_BLOCK);
+		size_t chunk;
+
+		if (blocks == 0) {
+			blocks = 1;             /* a partial tail block */
+		}
+		error = ufs_read_blocks(base + off / UFS_BLOCK, blocks);
+		if (error) {
+			return error;
+		}
+		chunk = (size_t)blocks * UFS_BLOCK;
+		if (chunk > len) {
+			chunk = len;
+		}
+		memcpy(out, (const void *)(su.dma + DMA_BOUNCE), chunk);
+		out += chunk;
+		off += chunk;
+		len -= chunk;
+	}
+	return 0;
+}
